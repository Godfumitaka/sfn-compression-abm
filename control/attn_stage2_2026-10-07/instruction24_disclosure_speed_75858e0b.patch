--- /dev/null
+++ b/tools/attnstage2_isolation.py
@@ -0,0 +1,55 @@
+"""指示24の開示だけの旗。保存済みの同じ控えを二重に作らない。"""
+from contextlib import contextmanager
+
+from attncstar import Session as OriginalSession
+
+
+@contextmanager
+def isolated():
+    """元と同じ復元順・古い辞書の参照も保ち、保存の複製だけ省く。
+
+    smeshared.installが接続した保存窓口は、SMEの全控えと乱数を既に
+    含む。外側の追加控えへ同じ保存値を渡す。入れ子の各保存は残す。
+    """
+    import attnsme
+    import probeworld
+    import smeshared as S
+    import smeevict
+    for function, name in ((probeworld._snapshot_modules, 'snapshot_modules'),
+                           (probeworld._restore_modules, 'restore_modules')):
+        if function.__module__ != S.__name__ or function.__name__ != name:
+            raise RuntimeError('開示の保存控えの共有には元のSME保存窓口が必要')
+    # snapshot_modulesはLOGのdiagnosticを変えるので、その前に控える。
+    log = dict(S.LOG)
+    dictionaries = (S.STATS, S.CTX, S.RESULTS, S.GRAPHS, S.CHOICES,
+                    S.ENGINE.cache, S.ENGINE.self_cache, S.ENGINE.cache_rng)
+    manager = smeevict.MANAGER
+    epochs = None if manager is None else {k: dict(v) for k, v in manager.epochs.items()}
+    snap = attnsme._snapshot()
+    saved = None
+    rng = None
+    try:
+        ordinary, own, phase = snap[0]
+        engine, results, graphs, choices, stats, context = own[:6]
+        rng, cache, self_cache, cache_rng = engine
+        saved = (stats, context, results, graphs, choices, cache, self_cache, cache_rng)
+        S.LOG.update(f=None, diagnostic_f=None)
+        yield
+    finally:
+        attnsme._restore(snap)
+        # ENGINE.restoreは新しい辞書を作る。以前の参照の中身も元どおり戻す。
+        for current, backup in zip(dictionaries, saved or ()):
+            current.clear()
+            current.update(backup)
+        S.LOG.clear()
+        S.LOG.update(log)
+        if rng is not None:
+            S.ENGINE.rng.setstate(rng)
+        if manager is not None:
+            manager.epochs = epochs
+
+
+class Session(OriginalSession):
+    """開示のSessionだけ。点・対応・再照合・回答・入れ子の隔離は同じ。"""
+    def isolated(self):
+        return isolated()
