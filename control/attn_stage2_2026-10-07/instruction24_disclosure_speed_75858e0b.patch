+from test_sme2017_connection import separate
+from attnstage2_distribution import Readout
+
+
+@pytest.mark.parametrize('exception', [False, True])
+def test_nested_snapshot_restores_contents_old_cache_aliases_and_rng(separate, monkeypatch, exception):
+    manager = SimpleNamespace(epochs={'old': {'a': 1}})
+    monkeypatch.setattr(smeevict, 'MANAGER', manager)
+    S.LOG.update(diagnostic=False, f=None, diagnostic_f=None)
+    for isolated in (N.isolated, F.isolated):
+        aliases = (S.STATS, S.CTX, S.RESULTS, S.GRAPHS, S.CHOICES,
+                   S.ENGINE.cache, S.ENGINE.self_cache, S.ENGINE.cache_rng)
+        contents = [dict(d) for d in aliases]
+        before, log, rng = S.snapshot(), dict(S.LOG), S.ENGINE.rng.getstate()
+        try:
+            with isolated():
+                for d in aliases:
+                    d['temporary'] = 3
+                manager.epochs['old']['a'] = 2
+                S.ENGINE.rng.random()
+                outer = S.snapshot()
+                with isolated():
+                    S.CTX['temporary'] = 4
+                    S.ENGINE.rng.random()
+                    S.LOG['temporary'] = True
+                assert S.snapshot() == outer
+                if exception:
+                    raise ValueError('意図した例外')
+        except ValueError:
+            assert exception
+        assert [dict(d) for d in aliases] == contents
+        assert S.snapshot() == before
+        assert S.LOG == log
+        assert S.ENGINE.rng.getstate() == rng
+        assert manager.epochs == {'old': {'a': 1}}
+
+
+def test_snapshot_without_original_sme_hook_is_rejected(separate, monkeypatch):
+    monkeypatch.setattr(probeworld, '_snapshot_modules', lambda: [])
+    with pytest.raises(RuntimeError, match='保存窓口'):
+        with F.isolated():
+            raise AssertionError('未接続の保存を共有した')
+
+
+@pytest.mark.parametrize('loss_mode', ['alpha', 'top1', 'mixture'])
+@pytest.mark.parametrize('thinned', [False, True])
+def test_all_seats_native_Cstar_rows_and_permutation_are_identical(cstar, retained_U_structure,
+                                                                  loss_mode, thinned):
+    state, config, obs, ai = build()
+    if thinned:
+        state = v39._convert(state, 'FH', 'R', 1, 1)[0]
+    before = repr(state), repr(obs.__dict__), S.snapshot(), dict(S.LOG)
+    args = (ai, state, config, Random(1).getstate(), obs, {'independent-key': .5})
+    kwargs = dict(mode='global', position='k2', door_task=True, epsilon=.01,
+                  readout_policy=Readout(), feature_policy=C.Features())
+    original, fast = C.Session(*args, **kwargs), F.Session(*args, **kwargs)
+    assert original.candidates == fast.candidates
+    seats = tuple(T.Seat(d.name, r.slot_index, v39.seat_state(d, r, state.slot_history),
+                         state.v39_seats[d.name, r.slot_index].gen)
+                  for d in state.definitions.values() for r in d.constituents
+                  if v39.seat_state(d, r, state.slot_history) != 'U')
+    results = []
+    for session in (original, fast):
+        rows, work = T.compare_seats(session.candidates, args[-1], seats, session.rematched, None,
+                                    correct=('hold', ('x',)), ell=3, mode=loss_mode,
+                                    choose=session.choose, background=session.background,
+                                    method='rematched')
+        results.append((rows, {k: v for k, v in work.items() if k != 'seconds'}))
+    assert results[0] == results[1]
+    reversed_rows, _ = T.compare_seats(fast.candidates, args[-1], reversed(seats), fast.rematched, None,
+                                     correct=('hold', ('x',)), ell=3, mode=loss_mode,
+                                     choose=fast.choose, background=fast.background, method='rematched')
+    assert reversed_rows == list(reversed(results[0][0]))
+    assert (repr(state), repr(obs.__dict__), S.snapshot(), dict(S.LOG)) == before
diff --git a/tools/attnstage2_isolation.py b/tools/attnstage2_isolation.py
