index 0000000..06a6276
--- /dev/null
+++ b/tests/test_smeshared_json_log.py
@@ -0,0 +1,94 @@
+"""監査の書出しだけを直し、正常時のバイトと模型の辞書を保つ。"""
+from pathlib import Path
+import copy
+import io
+import json
+import random
+import sys
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+import smeshared as S
+
+
+@pytest.fixture(autouse=True)
+def sink(monkeypatch):
+    out = io.StringIO()
+    monkeypatch.setattr(S, 'LOG', {'f': out, 'diagnostic': False})
+    monkeypatch.setattr(S, '_diagnosing', lambda: False)
+    return out
+
+
+@pytest.mark.parametrize('record', [
+    {'kind': 'sme_use', 'reused': True, 'result': '名前'},
+    {'nested': {'b': 0.1, 'a': None}, 'tuple': (1, '名前')},
+    {'distribution': {None: 1.0}},
+    {'numbers': {1: 'a', 2: 'b'}},
+])
+def test_success_keeps_exact_old_bytes_and_never_converts(record, sink, monkeypatch):
+    expected = json.dumps(record, ensure_ascii=False, sort_keys=True) + '\n'
+    def blocked(value):
+        raise AssertionError('正常な記録でfallbackを使った')
+    monkeypatch.setattr(S, '_log_string_keys', blocked)
+    S._log(record)
+    assert sink.getvalue() == expected
+
+
+def test_nested_mixed_none_keys_and_frozen_dict_leave_input_and_rng_unchanged(sink):
+    distribution = S.freeze({'sig_e': 0.75, None: 0.25})
+    record = {'kind': 'sme_result', 'nested': [({'distribution': distribution},)]}
+    before = copy.deepcopy(record)
+    state = random.getstate()
+    with pytest.raises(TypeError):
+        json.dumps(record, ensure_ascii=False, sort_keys=True)
+    S._log(record)
+    expected = {'kind': 'sme_result', 'nested': [[{'distribution': {'sig_e': 0.75, 'null': 0.25}}]]}
+    assert sink.getvalue() == json.dumps(expected, ensure_ascii=False, sort_keys=True) + '\n'
+    assert record == before
+    assert record['nested'][0][0]['distribution'] is distribution
+    assert None in distribution and 'null' not in distribution
+    assert random.getstate() == state
+
+
+def test_json_key_spelling_uses_native_null_boolean_and_numeric_forms(sink):
+    record = {'mixed': {None: 'n', False: 'f', 2.5: 'x', 'name': 's'}}
+    S._log(record)
+    assert json.loads(sink.getvalue())['mixed'] == {'null': 'n', 'false': 'f', '2.5': 'x', 'name': 's'}
+
+
+def test_diagnostic_sink_keeps_destination(sink, monkeypatch):
+    out = io.StringIO()
+    S.LOG.update(diagnostic=True, diagnostic_f=out)
+    S._log({'p': {None: 0.5, 'name': 0.5}})
+    assert not sink.getvalue()
+    assert json.loads(out.getvalue())['p'] == {'null': 0.5, 'name': 0.5}
+
+
+def test_no_open_sink_never_serializes(monkeypatch):
+    S.LOG['f'] = None
+    S._log({'unsupported': object()})
+
+
+def test_other_serialization_errors_propagate_without_partial_write(sink):
+    with pytest.raises(TypeError):
+        S._log({'unsupported': object()})
+    assert not sink.getvalue()
+
+
+def test_key_collision_does_not_silently_drop_a_record(sink):
+    with pytest.raises(TypeError, match='衝突'):
+        S._log({'p': {None: 0.25, 'null': 0.25, 'name': 0.5}})
+    assert not sink.getvalue()
+
+
+def test_write_failure_is_not_caught_as_serialization_fallback(monkeypatch):
+    class BrokenSink:
+        def write(self, text):
+            raise TypeError('write failed')
+    S.LOG['f'] = BrokenSink()
+    def blocked(value):
+        raise AssertionError('書込失敗をfallbackにした')
+    monkeypatch.setattr(S, '_log_string_keys', blocked)
+    with pytest.raises(TypeError, match='write failed'):
+        S._log({'kind': 'sme_use'})
diff --git a/tools/smeshared.py b/tools/smeshared.py
