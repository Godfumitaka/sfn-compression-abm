+"""GCの有効状態・例外復元と、fork後の全原記録・研究者の数えを検査する。"""
+from pathlib import Path
+import sys
+sys.path[:0]=[str(Path(__file__).resolve().parents[1]/'tools')]
+import pytest
+import attnstage2_birth_parallel as P
+from test_birth_workers_instruction22 import test_parallel_matches_original_order_counts_and_gzip as _check_original
+
+
+@pytest.mark.parametrize('initial',[False,True])
+def test_gc_state_restored_on_pool_exception(monkeypatch,initial):
+    calls=[];state={'enabled':initial,'frozen':0}
+    monkeypatch.setattr(P.gc,'get_freeze_count',lambda:state['frozen'])
+    monkeypatch.setattr(P.gc,'isenabled',lambda:state['enabled'])
+    def disable():state['enabled']=False;calls.append('disable')
+    def enable():state['enabled']=True;calls.append('enable')
+    def freeze():state['frozen']=1;calls.append('freeze')
+    def unfreeze():state['frozen']=0;calls.append('unfreeze')
+    monkeypatch.setattr(P.gc,'disable',disable);monkeypatch.setattr(P.gc,'enable',enable)
+    monkeypatch.setattr(P.gc,'freeze',freeze);monkeypatch.setattr(P.gc,'unfreeze',unfreeze)
+    with pytest.raises(ValueError,match='pool'):
+        with P.frozen_for_fork() as enabled:
+            assert enabled==initial and not state['enabled'] and state['frozen']==1
+            raise ValueError('pool')
+    assert state=={'enabled':initial,'frozen':0}
+    assert calls==['disable','freeze','unfreeze']+(['enable'] if initial else [])
+
+
+def test_preexisting_frozen_generation_is_not_unfrozen(monkeypatch):
+    monkeypatch.setattr(P.gc,'get_freeze_count',lambda:3)
+    monkeypatch.setattr(P.gc,'unfreeze',lambda:pytest.fail('他の固定を外さない'))
+    with pytest.raises(RuntimeError,match='既にGC'):
+        with P.frozen_for_fork():pytest.fail('重ねない')
+
+
+@pytest.mark.parametrize('workers',[1,4])
+@pytest.mark.parametrize('hu',[False,True])
+def test_freeze_keeps_original_fork_order_all_counts_and_rng(monkeypatch,tmp_path,workers,hu):
+    before=(P.gc.isenabled(),P.gc.get_freeze_count())
+    assert before[1]==0
+    monkeypatch.setattr(P,'_FREEZE',True)
+    _check_original(monkeypatch,tmp_path,workers,hu)
+    assert (P.gc.isenabled(),P.gc.get_freeze_count())==before
