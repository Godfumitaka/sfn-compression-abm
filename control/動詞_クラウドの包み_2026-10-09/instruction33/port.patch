+    try:
+        state,cfg,obs,ai=build();definition=replace(state.definitions['R'],name='new',registered_at=2)
+        pre=(ai,state,cfg,Random(1).getstate(),obs,{},True,(),None)
+        ctx={'definition':definition,'row':definition.constituents[0],'first_material':ai.base_graph,
+             'second_visible':ai.target_graph_partial,'trial':2,'base_age':1,'pre':pre,
+             'questions':Snapshot(1,1,frozenset({'hold'}),frozenset(),True)}
+        monkeypatch.setattr(L,'EPSILON',.5)
+        saved=(repr(state),fingerprint(obs),S.ENGINE.rng.getstate(),Random(1).getstate())
+        outputs=[]
+        for flag in (False,True):
+            policy=I.VirtualInitial(loss_mode=loss_mode,mode='binary',position='k2',epsilon=.5,
+                                   readout_policy=Readout(),observation_view=flag)
+            value=policy(v39.SeatRec(0,'F',2,2,v39.ZERO4,v39.ZERO4),'birth',ctx)
+            rows=policy.drain_records();rows[0].pop('seconds')
+            outputs.append((value,json.dumps(rows,ensure_ascii=False)))
+            assert (repr(state),fingerprint(obs),S.ENGINE.rng.getstate(),pre[3])==saved
+        assert outputs[0]==outputs[1]
