@@ -0,0 +1,84 @@
+"""指示35：既存の観測だけを読む窓と、元の全欄のhash見張り。"""
+from collections import defaultdict
+from collections.abc import Mapping
+from contextlib import contextmanager
+import hashlib
+import pickle
+
+
+def fingerprint(observations):
+    # 表の値・順・型・全欄をそのまま含める。抽選・模型の記録を更新しない。
+    return hashlib.sha256(pickle.dumps(vars(observations), protocol=5)).digest()
+
+
+def readonly(value):
+    if isinstance(value, dict):
+        return ReadOnlyMap(value)
+    if isinstance(value, list):
+        return tuple(readonly(item) for item in value)
+    if isinstance(value, tuple):
+        return tuple(readonly(item) for item in value)
+    if isinstance(value, set):
+        return frozenset(readonly(item) for item in value)
+    if isinstance(value, frozenset):
+        return frozenset(readonly(item) for item in value)
+    if value is None or isinstance(value, (str, int, float, bool, bytes)):
+        return value
+    raise TypeError('観測に未知の可変型を渡さない')
+
+
+class ReadOnlyMap(Mapping):
+    __slots__ = ('_source',)
+
+    def __init__(self, source):
+        object.__setattr__(self, '_source', source)
+
+    def __setattr__(self, name, value):
+        raise TypeError('観測の読取窓へ書き込まない')
+
+    def __getitem__(self, key):
+        source = self._source
+        if key in source:
+            return readonly(source[key])
+        if isinstance(source, defaultdict) and source.default_factory in (list, set, dict):
+            # 元の局所deepcopyの欠落値と同じ読み。元表へ鍵を足さない。
+            return readonly(source.default_factory())
+        raise KeyError(key)
+
+    def __iter__(self):
+        return iter(self._source)
+
+    def __len__(self):
+        return len(self._source)
+
+    def __contains__(self, key):
+        return key in self._source
+
+    def get(self, key, default=None):
+        return readonly(self._source[key]) if key in self._source else default
+
+
+class ReadOnlyObservations:
+    __slots__ = ('_source',)
+
+    def __init__(self, source):
+        object.__setattr__(self, '_source', source)
+
+    def __setattr__(self, name, value):
+        raise TypeError('観測の読取窓へ書き込まない')
+
+    def __getattr__(self, name):
+        if name not in vars(self._source):
+            raise AttributeError(name)
+        return readonly(vars(self._source)[name])
+
+
+@contextmanager
+def unchanged(observations, expected):
+    if fingerprint(observations) != expected:
+        raise RuntimeError('出生の観測のhashが変わった')
+    try:
+        yield
+    finally:
+        if fingerprint(observations) != expected:
+            raise RuntimeError('出生の観測のhashが変わった')
