+"""読取窓の権限、元の全欄hash、実際の局所Sessionの一致を検査する。"""
+from copy import deepcopy
+from dataclasses import replace
+from pathlib import Path
+from random import Random
+import sys
+sys.path[:0]=[str(Path(__file__).resolve().parents[1]/'tools'),str(Path(__file__).resolve().parents[1])]
+import pytest
+from test_sme2017_connection import separate
+from attnsme_features import Observations
+from attnstage2_observation_view import ReadOnlyObservations, fingerprint, unchanged
+
+
+def observation():
+    o=Observations();o.entities.update(('x','y'));o.arguments[1]=('x','y')
+    o.parents[3].append((1,0));o.shapes['p'].add(('shape',));o.table[('k',)]={'p':3}
+    o.events.append({'trial':2,'visible_names':['p']});o.names.add('p');o.last_trial=2
+    return o
+
+
+def test_reads_preserve_order_values_and_default_without_mutation():
+    o=observation();before=fingerprint(o);v=ReadOnlyObservations(o)
+    assert tuple(v.arguments)==tuple(o.arguments) and v.arguments[1]==o.arguments[1]
+    assert v.parents[3]==tuple(o.parents[3]) and v.parents[999]==()
+    assert v.shapes['absent']==frozenset() and v.shapes.get('absent') is None
+    assert 999 not in v.parents and 'absent' not in v.shapes
+    assert v.table[('k',)]['p']==3 and v.last_trial==2
+    assert fingerprint(o)==before
+
+
+@pytest.mark.parametrize('change',[
+    lambda v:setattr(v,'last_trial',4),
+    lambda v:v.arguments.__setitem__(1,()),
+    lambda v:v.entities.add('z'),
+    lambda v:v.events[0].__setitem__('trial',4),
+    lambda v:v.parents[3].append((2,0)),
+])
+def test_nested_and_top_level_writes_are_rejected(change):
+    o=observation();before=fingerprint(o)
+    with pytest.raises((TypeError,AttributeError)):change(ReadOnlyObservations(o))
+    assert fingerprint(o)==before
+
+
+def test_hash_guard_catches_backdoor_change_and_keeps_failure():
+    o=observation();before=fingerprint(o)
+    with pytest.raises(RuntimeError,match='hash'):
+        with unchanged(o,before):o.table[('k',)]['p']=4
+    assert o.table[('k',)]['p']==4  # 差を直して合格にしない。
+    with pytest.raises(RuntimeError,match='hash'):
+        with unchanged(o,before):pass
+
+
+@pytest.mark.parametrize('loss_mode',['alpha','top1','mixture'])
+def test_native_local_birth_bytes_state_rng_equal_with_readonly(separate,loss_mode,monkeypatch):
+    import attnstage2_initial as I
+    import smeshared as S
+    import ustruct
+    import v39
+    import v310be as L
+    from attnstage2_distribution import Readout
+    from attnstage2_questions import Snapshot
+    from test_attnstage2_connection import build
+    import json
