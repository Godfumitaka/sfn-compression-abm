+class OneField:
+    def __init__(self, key, value):
+        self.key, self.value, self.reads = key, value, []
+    def __getitem__(self, key):
+        self.reads.append(key)
+        assert key == self.key, '指示以外の研究者欄を読んだ'
+        return self.value
