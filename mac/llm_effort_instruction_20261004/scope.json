  "type": "object",
  "properties": {
   "answer": {
    "type": "string"
   },
   "confidence": {
    "type": "number"
   },
   "respond": {
    "type": "boolean"
   }
  },
  "required": [
   "answer",
   "confidence",
   "respond"
  ],
  "additionalProperties": false
 },
 "task_limit_dollars": 4,
