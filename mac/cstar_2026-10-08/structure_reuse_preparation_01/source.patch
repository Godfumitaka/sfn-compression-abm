diff --git a/tools/smereuse_structure.py b/tools/smereuse_structure.py
new file mode 100644
index 0000000..99cf6be
--- /dev/null
+++ b/tools/smereuse_structure.py
@@ -0,0 +1,54 @@
+"""同じ不変な図の索引と高さだけを共有する探索の旗。"""
+from functools import lru_cache
+from types import MappingProxyType
+
+MAX_GRAPHS = 256
+
+
+def _make_tables(nodes):
+    # 鍵は全Nodeの元の順。型・引数の順・F/H/U・許容名を落とさない。
+    # qや種が違っても、この二つの純粋な部品は同じ。照合は再計算する。
+    by = {n.key: n for n in nodes}
+    memo, active = {}, set()
+
+    def visit(k):
+        if k in active:
+            raise ValueError("循環した式")
+        if k not in memo:
+            active.add(k)
+            n = by[k]
+            memo[k] = 0 if n.kind == "entity" else 1 + max((visit(a) for a in n.args or ()), default=0)
+            active.remove(k)
+        return memo[k]
+
+    for k in by:
+        visit(k)
+    # 照合器は索引と高さを読むだけ。共有した辞書を書き換えられなくする。
+    return MappingProxyType(by), MappingProxyType(memo)
+
+
+@lru_cache(maxsize=MAX_GRAPHS)
+def _cached_tables(nodes, name_order):
+    # 等しいfrozensetでも列挙順が違えば、元のNodeを別の控えにする。
+    return _make_tables(nodes)
+
+
+def tables(nodes):
+    name_order = tuple(tuple(n.names) for n in nodes)
+    try:
+        hash((nodes, name_order))
+    except TypeError:
+        return _make_tables(nodes)
+    return _cached_tables(nodes, name_order)
+
+
+def install():
+    import sme2017
+    _cached_tables.cache_clear()
+    sme2017.GRAPH_TABLES = tables
+
+
+def close():
+    import sme2017
+    sme2017.GRAPH_TABLES = None
+    _cached_tables.cache_clear()
